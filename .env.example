# Copier en .env. Authentification sans clé : az login.

# Portail Foundry > projet > Vue d'ensemble
FOUNDRY_PROJECT_ENDPOINT=https://<ressource>.services.ai.azure.com/api/projects/<projet>

# Noms des déploiements
CHAT_MODEL_DEPLOYMENT=gpt-4.1-mini
CANDIDATE_MODEL_DEPLOYMENT=gpt-4.1
EVAL_MODEL_DEPLOYMENT=gpt-4.1

# Racine Azure OpenAI de la ressource, utilisée par azure-ai-evaluation
AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# Renseigné par m4_tools/setup_vector_store.py
VECTOR_STORE_ID=

# web_search ou web_search_preview selon la région
WEB_SEARCH_TOOL_TYPE=web_search

# Optionnel, après fine-tuning
FINETUNED_MODEL_DEPLOYMENT=
